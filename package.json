{
  "name": "hchat",
  "version": "0.1.0",
  "private": true,
  "description": "HChat - 可自托管的聊天基础设施（C2C / C2AI / AI 辅助），后端 Spring Boot，前端多形态 SDK",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . --cache",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "server:build": "mvn -q -f server/pom.xml -DskipTests package",
    "server:dev": "mvn -f server/pom.xml spring-boot:run -Dspring-boot.run.profiles=dev",
    "server:test": "mvn -f server/pom.xml test",
    "server:it": "mvn -f server/pom.xml verify -Pit",
    "demo": "node examples/ai-agent-demo/dist/index.js",
    "compose:up": "docker compose -f deploy/docker-compose.yml up --build",
    "compose:down": "docker compose -f deploy/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.24.0"
  }
}
