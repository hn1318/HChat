{
  "name": "hchat-server-sdk-node",
  "version": "0.1.0",
  "description": "HChat 服务端 SDK（Node）：签发短期 Token、校验 Webhook 签名",
  "keywords": [
    "hchat",
    "chat",
    "webhook",
    "jwt",
    "server-sdk"
  ],
  "license": "Apache-2.0",
  "author": "HChat contributors",
  "homepage": "https://github.com/hchat-dev/hchat/tree/main/packages/server-sdk-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hchat-dev/hchat.git",
    "directory": "packages/server-sdk-node"
  },
  "bugs": {
    "url": "https://github.com/hchat-dev/hchat/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hchat-shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "vitest": "^3.0.5"
  }
}
