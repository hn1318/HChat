# ===== HChat 环境变量示例（复制为 .env 后按需修改）=====

# ---------- 服务 ----------
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# 单租户模式下的默认租户
DEFAULT_TENANT_ID=default
# 开发模式：开放 /api/v1/auth/dev-token（生产务必设为 false）
DEV_MODE=true
# 多实例部署时给每个实例分配唯一 worker id（0-1023），用于雪花 ID
WORKER_ID=0

# ---------- 数据库 ----------
# 生产：MySQL 8
DATABASE_URL=jdbc:mysql://localhost:3306/hchat?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false
DATABASE_USERNAME=hchat
DATABASE_PASSWORD=hchat
DB_POOL_SIZE=20

# ---------- 鉴权 ----------
# 至少 32 字节，服务端会再做一次 SHA-256 派生
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000

# ---------- 存储 ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/uploads
S3_ENDPOINT=
S3_BUCKET=hchat
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PATH_STYLE=true

# ---------- AI ----------
# mock（无需 Key，内置演示） | openai-compatible
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=120

# ---------- 限额 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_RPS=60
RATE_LIMIT_USER_RPS=30
RATE_LIMIT_APP_RPS=300
RATE_LIMIT_BURST=2
MAX_MESSAGE_LENGTH=4000
RECALL_WINDOW_SECONDS=120
MAX_FILE_BYTES=20971520

# ---------- Webhook ----------
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_INITIAL_BACKOFF_MS=1000

# ---------- Redis（可选，多实例部署时启用）----------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ---------- 数据库迁移 / 演示数据 ----------
# 需要 app_demo 演示租户时追加 seed 目录
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
