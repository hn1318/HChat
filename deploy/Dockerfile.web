# 前端应用（playground / embed）的通用镜像：pnpm 构建 → nginx 托管静态产物
# 构建上下文必须是仓库根目录：
#   docker build -f deploy/Dockerfile.web --build-arg APP=playground .

FROM node:22-alpine AS build
WORKDIR /repo

RUN corepack enable

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc tsconfig.base.json turbo.json ./
COPY scripts ./scripts
COPY packages ./packages
COPY apps ./apps
COPY examples ./examples

RUN pnpm install --frozen-lockfile

ARG APP=playground
ARG VITE_HCHAT_BASE_URL=http://localhost:8080
ARG VITE_HCHAT_APP_ID=app_demo
ENV VITE_HCHAT_BASE_URL=$VITE_HCHAT_BASE_URL \
    VITE_HCHAT_APP_ID=$VITE_HCHAT_APP_ID

# turbo 会按依赖拓扑先构建 shared-types / core-sdk / react-chat
RUN ./node_modules/.bin/turbo run build --filter=hchat-$APP... \
    && cp -r apps/$APP/dist /app-dist

FROM nginx:1.27-alpine
COPY --from=build /app-dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
